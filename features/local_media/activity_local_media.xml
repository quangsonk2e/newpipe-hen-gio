<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/local_media_library_heading"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/local_media_description"
        android:textSize="12sp"
        android:alpha="0.72"
        android:paddingBottom="10dp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/localTypeTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp">
        <Button
            android:id="@+id/localMediaOpenFile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/local_media_open_file"
            android:drawableStart="@android:drawable/ic_menu_add"
            android:drawablePadding="4dp"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/localMediaRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/local_media_refresh"
            android:textAllCaps="false" />
    </LinearLayout>

    <EditText
        android:id="@+id/localMediaSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:inputType="text"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:hint="@string/local_media_search"
        android:importantForAutofill="no"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">
        <Spinner
            android:id="@+id/localMediaFolders"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:contentDescription="@string/local_media_folders" />
        <Spinner
            android:id="@+id/localMediaSort"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:contentDescription="@string/local_media_sort" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/localMediaProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/localMediaStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/local_media_scanning"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/localMediaEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="25dp"
        android:text="@string/local_media_empty"
        android:visibility="gone" />

    <ListView
        android:id="@+id/localMediaList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:dividerHeight="0dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />
    <LinearLayout
        android:id="@+id/localMediaMiniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/local_media_icon_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/localMiniTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/local_media_playing"
            android:textColor="@android:color/white"
            android:paddingStart="10dp" />
        <Button
            android:id="@+id/localMiniPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/local_media_pause"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/localMiniOpen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/local_media_open_player"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
